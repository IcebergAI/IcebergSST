# IcebergSST development environment.
#
#   make init-env    # copy this file to .env with fresh secrets generated
#   make up          # build, start, migrate
#
# Values marked CHANGE_ME are filled in by `make init-env`; nothing here is a
# real credential. Production sets the same variables from a k8s Secret
# (docs/deployment.md), never from a file in the repository.

# ─── Shared ───────────────────────────────────────────────────────────────────
# dev | test | prod
ICEBERG_ENVIRONMENT=dev
ICEBERG_LOG_LEVEL=INFO

# ─── Postgres (api role only) ─────────────────────────────────────────────────
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=iceberg

# ─── Redis (broker; shared by api and engines) ────────────────────────────────
# Auth is on even in dev: any engine that reaches Redis can read the queue
# (docs/security.md, boundary 3).
REDIS_PASSWORD=CHANGE_ME

# ─── Secret store (api role only — ADR 0007) ──────────────────────────────────
# env_key is the default backend; vault is a documented seam, not yet implemented.
ICEBERG_SECRET_STORE_BACKEND=env_key

# AES-256 master key, base64. Protecting and rotating it is the operator's job.
#   python -m iceberg_core.secrets generate-master-key
ICEBERG_MASTER_KEY=CHANGE_ME

# The fingerprint pepper, as a sealed ref — the pepper itself is never written
# down. Rotating it invalidates every finding identity (ADR 0006/0007).
#   python -m iceberg_core.secrets generate-pepper
ICEBERG_FINGERPRINT_PEPPER_REF=CHANGE_ME

# ─── Engine role ──────────────────────────────────────────────────────────────
# The per-engine API credential. In production this is minted at deploy time
# (docs/security.md § Bootstrap), never defaulted into an image.
ICEBERG_ENGINE_TOKEN=CHANGE_ME

# ─── Local ports ──────────────────────────────────────────────────────────────
ICEBERG_API_PORT=8000
