# IcebergSST development environment.
#
#   make init-env                      # copy this file to .env with fresh secrets
#   make up                            # build, start the control plane, migrate
#   ./deploy/compose/engine-token.sh   # mint an engine token and start the engine
#
# `make init-env` generates every secret it can (passwords, keys, the sealed
# pepper). Anything still marked CHANGE_ME afterwards has to come from elsewhere —
# the OIDC client secret is issued by your identity provider — and init-env prints
# what is outstanding. The engine token is the third case: only the api can mint
# one, and only against a migrated database, which is why it is a step after
# `make up` rather than a value generated here. Nothing here is a real credential.
# Production sets the same variables from a k8s Secret (docs/deployment.md), never
# from a file in the repo.

# ─── Shared ───────────────────────────────────────────────────────────────────
# dev | test | prod
ICEBERG_ENVIRONMENT=dev
ICEBERG_LOG_LEVEL=INFO

# ─── Postgres (api role only) ─────────────────────────────────────────────────
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=iceberg

# ─── Redis (broker; shared by api and engines) ────────────────────────────────
# Auth is on even in dev: any engine that reaches Redis can read the queue
# (docs/security.md, boundary 3).
REDIS_PASSWORD=CHANGE_ME

# ─── Secret store (api role only — ADR 0007) ──────────────────────────────────
# env_key is the default backend; vault is a documented seam, not yet implemented.
ICEBERG_SECRET_STORE_BACKEND=env_key

# AES-256 master key, base64. Protecting and rotating it is the operator's job.
#   python -m iceberg_core.secrets generate-master-key
ICEBERG_MASTER_KEY=CHANGE_ME

# The fingerprint pepper, as a sealed ref — the pepper itself is never written
# down. Rotating it invalidates every finding identity (ADR 0006/0007).
#   python -m iceberg_core.secrets generate-pepper
ICEBERG_FINGERPRINT_PEPPER_REF=CHANGE_ME
# Set ONLY while rotating the pepper (docs/runbooks/key-rotation.md). Finding
# identity is an HMAC keyed by the pepper and the plaintext was never stored, so
# a new pepper cannot be applied to existing rows — instead, while both are set,
# engines report each finding under both and ingest re-keys the match, carrying
# the triage state across. Unset it once every source has been scanned.
ICEBERG_PREVIOUS_FINGERPRINT_PEPPER_REF=

# The exposure-cluster correlation key, as a sealed ref (ADR 0010). Optional:
# unset means findings carry no correlation id and the cluster views stay
# empty. API-role only — never handed to engines. Rotating it is a recompute,
# not a rescan: swap the ref, then `python -m iceberg_api reindex-correlation`.
#   python -m iceberg_core.secrets generate-correlation-key
ICEBERG_CORRELATION_KEY_REF=

# ─── Authentication (api role only — ADR 0005) ─────────────────────────────────
# OIDC provider. The API discovers endpoints from the issuer's
# /.well-known/openid-configuration, and rejects a document claiming another issuer.
ICEBERG_OIDC_ISSUER=https://idp.example.test/realms/iceberg
ICEBERG_OIDC_CLIENT_ID=iceberg-sst
ICEBERG_OIDC_CLIENT_SECRET=CHANGE_ME
ICEBERG_OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback

# Signs session and login-state cookies. At least 32 bytes (RFC 7518 §3.2);
# rotating it logs everyone out.
#   python -m iceberg_core.secrets generate-master-key
ICEBERG_SESSION_SECRET=CHANGE_ME
ICEBERG_SESSION_TTL_MINUTES=480

# false only for local HTTP: a session cookie sent in clear can be stolen in transit.
ICEBERG_COOKIE_SECURE=false

# The seed administrator, matched on first login only (docs/security.md § Bootstrap).
# Everyone else starts as viewer.
ICEBERG_BOOTSTRAP_ADMIN_SUBJECT=
ICEBERG_BOOTSTRAP_ADMIN_EMAIL=you@example.test

# ─── Detection (api role — #70) ───────────────────────────────────────────────
# Matches scoring below this are dropped. Set on the API and delivered to engines
# in their lease, so there is one value in one place; ingest applies it again, so
# an engine running a stale image cannot flood the queue. Raise it for a noisier
# corpus, lower it to see what the rules are nearly matching.
ICEBERG_CONFIDENCE_THRESHOLD=0.5

# ─── Notifications (api role) ─────────────────────────────────────────────────
# Channels are configured in the console; these are the deployment facts behind
# them (docs/notifications.md). Delivery runs in the API's maintenance loop, so
# none of this reaches an engine.
#
# Leave ICEBERG_SMTP_HOST empty to disable email: an email channel's deliveries
# then fail loudly naming this variable, rather than quietly going nowhere.
ICEBERG_SMTP_HOST=
ICEBERG_SMTP_PORT=587
# Omit both for an unauthenticated relay.
ICEBERG_SMTP_USERNAME=
ICEBERG_SMTP_PASSWORD=
# Certificates are verified. Only turn this off for a relay on localhost.
ICEBERG_SMTP_STARTTLS=true
ICEBERG_SMTP_FROM=icebergsst@localhost

# Attempts before a delivery is given up on. The row is kept either way — giving
# up is recorded, never silent.
ICEBERG_NOTIFICATION_MAX_ATTEMPTS=5
# First retry delay in seconds; doubles each attempt.
ICEBERG_NOTIFICATION_RETRY_BACKOFF_SECONDS=60
# ─── Rate limiting (api role, #63) ────────────────────────────────────────────
# Ceilings on what an unauthenticated caller can reach. Not the last line of
# defence — authentication is — so these stop floods rather than meter usage
# (docs/security.md § Rate limiting).
ICEBERG_RATE_LIMIT_ENABLED=true
# Auth entry points, per client address, per minute.
ICEBERG_AUTH_RATE_LIMIT=20
# Accepted engine traffic, per *engine* — a fleet behind one NAT must not share
# a budget. Rejected token presentations are limited per address instead.
ICEBERG_ENGINE_RATE_LIMIT=600
ICEBERG_ENGINE_AUTH_RATE_LIMIT=30
# How many reverse proxies sit in front. 0 ignores X-Forwarded-For, which is the
# safe default — a caller can put anything in that header. BEHIND A LOAD BALANCER
# THIS MUST BE SET, or every request is charged to the balancer's address.
ICEBERG_TRUSTED_PROXY_HOPS=0

# ─── Data retention (api role, #73) ───────────────────────────────────────────
# All three windows are OFF by default, and that is deliberate: this database
# records where your secrets are and who did what about them, so deleting any of
# it should be a decision, not an upgrade side effect (docs/retention.md).
#
# 0 = keep forever. Open findings, analyst decisions (false_positive,
# accepted_risk, manual resolutions) and suppressed findings are never eligible
# whatever these say.
ICEBERG_RETENTION_RESOLVED_FINDINGS_DAYS=0
ICEBERG_RETENTION_FINDING_EVENTS_DAYS=0
# Usually the window a compliance regime names. You cannot get these rows back.
ICEBERG_RETENTION_AUDIT_EVENTS_DAYS=0

# ─── Engine role ──────────────────────────────────────────────────────────────
# The per-engine API credential. In production this is minted at deploy time
# (docs/security.md § Bootstrap), never defaulted into an image.
# `mint-engine-token` prints both. The id is part of the credential: an engine
# names itself in its heartbeat path and the API checks the two agree, so a token
# without its id can lease and report but never renew a lease.
#
# Blank here on purpose, and filled in by ./deploy/compose/engine-token.sh once
# the stack is up: the API keeps only the token's hash, so a value invented in
# this file could only ever be rejected. An engine refuses to start without one
# rather than idling on a queue it cannot process, which is why the engine
# service sits behind a compose profile until this pair is set.
ICEBERG_ENGINE_ID=
ICEBERG_ENGINE_TOKEN=

# Concurrent scan tasks per engine process. Each holds a lease and a connection to
# the API, so this trades scan throughput against load on the control plane. Scale
# replicas too: `make scale N=3`.
ICEBERG_WORKER_THREADS=4

# ─── Local ports ──────────────────────────────────────────────────────────────
ICEBERG_API_PORT=8000

# ─── Compose ──────────────────────────────────────────────────────────────────
# Read by Docker Compose itself, not by IcebergSST. Empty leaves the engine
# service out, which is what makes the first `make up` succeed before any token
# exists; engine-token.sh sets it to `engine` once there is one, and from then on
# up/ps/logs all include engines.
COMPOSE_PROFILES=
