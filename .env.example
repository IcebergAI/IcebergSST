# IcebergSST development environment.
#
#   make init-env    # copy this file to .env with fresh secrets generated
#   make up          # build, start, migrate
#
# `make init-env` generates every secret it can (passwords, keys, the sealed
# pepper). Anything still marked CHANGE_ME afterwards has to come from elsewhere —
# the OIDC client secret is issued by your identity provider — and init-env prints
# what is outstanding. Nothing here is a real credential. Production sets the same
# variables from a k8s Secret (docs/deployment.md), never from a file in the repo.

# ─── Shared ───────────────────────────────────────────────────────────────────
# dev | test | prod
ICEBERG_ENVIRONMENT=dev
ICEBERG_LOG_LEVEL=INFO

# ─── Postgres (api role only) ─────────────────────────────────────────────────
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=iceberg

# ─── Redis (broker; shared by api and engines) ────────────────────────────────
# Auth is on even in dev: any engine that reaches Redis can read the queue
# (docs/security.md, boundary 3).
REDIS_PASSWORD=CHANGE_ME

# ─── Secret store (api role only — ADR 0007) ──────────────────────────────────
# env_key is the default backend; vault is a documented seam, not yet implemented.
ICEBERG_SECRET_STORE_BACKEND=env_key

# AES-256 master key, base64. Protecting and rotating it is the operator's job.
#   python -m iceberg_core.secrets generate-master-key
ICEBERG_MASTER_KEY=CHANGE_ME

# The fingerprint pepper, as a sealed ref — the pepper itself is never written
# down. Rotating it invalidates every finding identity (ADR 0006/0007).
#   python -m iceberg_core.secrets generate-pepper
ICEBERG_FINGERPRINT_PEPPER_REF=CHANGE_ME

# ─── Authentication (api role only — ADR 0005) ─────────────────────────────────
# OIDC provider. The API discovers endpoints from the issuer's
# /.well-known/openid-configuration, and rejects a document claiming another issuer.
ICEBERG_OIDC_ISSUER=https://idp.example.test/realms/iceberg
ICEBERG_OIDC_CLIENT_ID=iceberg-sst
ICEBERG_OIDC_CLIENT_SECRET=CHANGE_ME
ICEBERG_OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback

# Signs session and login-state cookies. At least 32 bytes (RFC 7518 §3.2);
# rotating it logs everyone out.
#   python -m iceberg_core.secrets generate-master-key
ICEBERG_SESSION_SECRET=CHANGE_ME
ICEBERG_SESSION_TTL_MINUTES=480

# false only for local HTTP: a session cookie sent in clear can be stolen in transit.
ICEBERG_COOKIE_SECURE=false

# The seed administrator, matched on first login only (docs/security.md § Bootstrap).
# Everyone else starts as viewer.
ICEBERG_BOOTSTRAP_ADMIN_SUBJECT=
ICEBERG_BOOTSTRAP_ADMIN_EMAIL=you@example.test

# ─── Engine role ──────────────────────────────────────────────────────────────
# The per-engine API credential. In production this is minted at deploy time
# (docs/security.md § Bootstrap), never defaulted into an image.
ICEBERG_ENGINE_TOKEN=CHANGE_ME

# ─── Local ports ──────────────────────────────────────────────────────────────
ICEBERG_API_PORT=8000
