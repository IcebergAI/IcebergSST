# IcebergSST development environment (issue #22).
#
#   cp .env.example .env    then replace every CHANGEME below.
#
# Read by docker-compose and by pydantic-settings (iceberg_core.config). Note
# that pydantic-settings loads this file into the Settings object only — it never
# populates os.environ — so code must go through ApiSettings/EngineSettings.
#
# Which role sees what is deliberate (ADR 0002): the api gets the database and
# the secret-store keys; the engine gets Redis and an API token, and nothing else.
# If you find yourself adding ICEBERG_DATABASE_URL to the engine service, stop —
# the field does not exist on EngineSettings and the design has gone wrong.

# ─── Postgres (api only) ────────────────────────────────────────────────────
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=CHANGEME-local-dev-password
POSTGRES_DB=iceberg
# Compose builds ICEBERG_DATABASE_URL from the three values above; override only
# to point at a database outside the compose stack. Must use the asyncpg driver.
# ICEBERG_DATABASE_URL=postgresql+asyncpg://iceberg:CHANGEME@postgres:5432/iceberg

# ─── Redis (both roles) ─────────────────────────────────────────────────────
ICEBERG_REDIS_URL=redis://redis:6379/0

# ─── Secret store — EnvKeyBackend (api only, ADR 0007) ──────────────────────
# Master key for encrypting connector credentials at rest. 32 bytes, base64.
# Mint one with:
#   uv run python -c "from iceberg_core.secrets.store import EnvKeyBackend; print(EnvKeyBackend.generate_key())"
ICEBERG_SECRET_KEY=CHANGEME-base64-32-byte-key

# Pepper for finding fingerprints. The api reads it and hands it to engines in
# the task lease response (ADR 0009) — never set this on an engine.
# WARNING: rotating this invalidates every finding identity and requires the
# re-keying procedure in ADR 0007. Treat it as long-lived.
ICEBERG_FINGERPRINT_PEPPER=CHANGEME-base64-pepper

# ─── Engine (engine only) ───────────────────────────────────────────────────
ICEBERG_API_BASE_URL=http://api:8000
# Minted at deploy time via a management command, never a default baked into an
# image (docs/security.md § Bootstrap). Left empty until #35 lands.
ICEBERG_ENGINE_TOKEN=

# ─── Host ports (compose only) ──────────────────────────────────────────────
# Change these if something else on your machine already owns the default.
ICEBERG_API_PORT=8000
ICEBERG_POSTGRES_PORT=5432
ICEBERG_REDIS_PORT=6379

# ─── Observability (both roles) ─────────────────────────────────────────────
ICEBERG_LOG_LEVEL=INFO
ICEBERG_METRICS_PORT=9191
